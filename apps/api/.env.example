# 백엔드 환경변수 예시 — 실제 값은 .env에 작성 (커밋 금지)
# 모든 외부 API 키는 이 서버에만 보관한다. 프론트엔드에 전달 금지.

PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ev_safecharge

# 공공데이터포털(data.go.kr) 공통 인증키 — 충전소·기상청·대구교통·관광 등 전부 공용
DATA_GO_KR_KEY=

# 개별 발급 키
TMAP_APP_KEY=
KAKAO_REST_KEY=

# 대구 통합주차정보시스템 (pis.daegu.go.kr) — API별 키 분리, 등록된 AWS 서버 IP에서만 호출 가능
DAEGU_PARKING_KEY=
DAEGU_PARKING_RT_KEY=
