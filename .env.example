# =============================================================================
# EV SafeCharge — .env.example (팀 공유용 템플릿)
# =============================================================================
# 사용법: 복사 → 레포 루트 `.env` → 아래 키 채움
# `.env` 는 Git 커밋 금지
#
# 위치: 레포 루트 `.env`
# 갱신: 2026-07-23 · DA➀
# =============================================================================

# -----------------------------------------------------------------------------
# [필수] 공공데이터포털 (data.go.kr) — Decoding 키 권장
# 용도: EvCharger(info/status) · Tour · 대구 ITS 소통(linkspeed)·돌발(dgincident)
# 비고: status 5분 + 소통 15분 루프가 같은 키·일 한도를 공유함
# -----------------------------------------------------------------------------
DATA_GO_KR_KEY=

# -----------------------------------------------------------------------------
# [필수·백엔드] TMAP
# 용도: ETA · POI · 길찾기 (프론트 NEXT_PUBLIC 에 넣지 말 것 — 서버만)
# -----------------------------------------------------------------------------
TMAP_APP_KEY=

# -----------------------------------------------------------------------------
# [선택·보류] 카카오 REST
# 용도: Local 카테고리 등 (브라우저에 넣지 말 것)
# 지도 JS 키는 apps/web/.env.example 의 NEXT_PUBLIC_KAKAO_MAP_JS_KEY
# -----------------------------------------------------------------------------
KAKAO_REST_KEY=

# -----------------------------------------------------------------------------
# [필수·돌발] UTIC (경찰청 도시교통정보센터)
# 용도: 실시간 돌발 (loop2)
# 비고: API 키 + 신청 IP 화이트리스트 둘 다 필요.
#       집(124.61.*)·교육장(118.41.246.0/24)은 서로 다른 키를 사용한다.
#       실행 장소에 맞춰 UTIC_KEY_PROFILE을 home 또는 education으로 설정한다.
#       Lightsail(3.36.50.99)에서 쓰려면 별도 키·IP 등록이 필요하다.
# -----------------------------------------------------------------------------
UTIC_KEY_PROFILE=home
UTIC_API_KEY_HOME=
UTIC_API_KEY_EDUCATION=

# -----------------------------------------------------------------------------
# [선택·현재 미사용] 대구 통합주차 PIS
# 용도: 주차 실시간/정적 — 등록된 AWS IP에서만 호출 가능
# -----------------------------------------------------------------------------
DAEGU_PARKING_KEY=
DAEGU_PARKING_RT_KEY=

# =============================================================================
# 역할별 최소 셋
#   DA➀ 수집·루프  : DATA_GO_KR_KEY  (+ UTIC_API_KEY 는 IP 등록된 환경만)
#   백엔드         : DATA_GO_KR_KEY, TMAP_APP_KEY
#   프론트         : apps/web/.env.example 만 (외부 REST 키 금지)
#   Lightsail 수집 : DATA_GO_KR_KEY 필수 · UTIC는 IP 등록 후
# =============================================================================
