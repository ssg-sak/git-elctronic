[Unit]
Description=EV SafeCharge daily tour↔charger usage analysis (batch)
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/ev-safecharge
EnvironmentFile=-/opt/ev-safecharge/.env
ExecStart=/opt/ev-safecharge/.venv/bin/python \
  apps/data-pipeline/processing/analysis/analyze_tour_charger_usage.py

# Log to journal
StandardOutput=journal
StandardError=journal
